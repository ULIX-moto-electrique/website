---
import Logo from '../assets/theme-images/logo.svg'
import LinkedInIcon from '../assets/theme-images/social-linkedIn.svg'
import InstagramIcon from '../assets/theme-images/social-instagram.svg'
import FacebookIcon from '../assets/theme-images/social-facebook.svg'
import EmailIcon from '../assets/theme-images/social-email.svg'
import WebsiteIcon from '../assets/theme-images/social-unknown.svg'

const { settings } = Astro.props

const socialIcons = {
  LinkedIn: LinkedInIcon,
  Instagram: InstagramIcon,
  Facebook: FacebookIcon,
  Courriel: EmailIcon,
  Website: WebsiteIcon
}

const credits = settings.credits
const year = new Date().getFullYear()
---

<footer class="@container ulix-container mt-24 mb-8 font-semibold text-foreground-dark [&_a]:hover:text-foreground-light [&_a]:transition-color [&_a]:duration-150" id="contact">
  <div class="bg-surface-3/10 p-4 md:p-8 rounded-xl flex justify-between gap-8">
    
    <!-- Left col -->
    <div class="flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-15 text-foreground-light">
      <a class="flex group" href="#top" aria-label="Back to top">
        <Logo
          class="group-hover:-rotate-180 group-hover:scale-80 transition-transform ease-spring duration-1000"
          height="72"
          width="72"
        />
      </a>

      <div class="flex flex-col gap-3">
        <a href={settings.join_us_link} class="ulix-btn-join">
          Rejoindre l’équipe
        </a>
        <a href="mailto:ulix@asso.ulaval.ca" class="ulix-btn-join">
          Devenir partenaire
        </a>
      </div>
    </div>

    <!-- Right col -->
    <div class="flex flex-wrap gap-4 md:justify-end">
      <nav class="flex flex-col gap-1 items-end">
        {settings.social_links
          .map(item => {
            const Icon = socialIcons[item.title] || socialIcons.Website

            return (
              <a href={item.link} class="group flex! items-center gap-3 rounded-md px-3 py-2 text-foreground-light transition-all duration-200 hover:bg-surface-2">
                <Icon class="opacity-70 transition-all duration-200 group-hover:opacity-100 group-hover:scale-110 flex items-center justify-center" />
                <span>{item.title}</span>
              </a>
            )
          })}
      </nav>
    </div>
  </div>

  {credits && (
    <div class="flex flex-wrap justify-between items-center gap-2 px-2 pt-4 text-sm font-medium">
      <span>© {year} {credits.copyright}.</span>
      <span>
        {credits.template_author && <>
          Gabarit par <a href={credits.template_link} target="_blank" rel="noreferrer noopener">{credits.template_author}</a>
        </>}.
      </span>
    </div>
  )}
</footer>
